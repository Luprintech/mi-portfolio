# ─────────────────────────────────────────────────────────────────────────────
# Frontend — variables de entorno (Vite)
# Copia este archivo a .env y rellena los valores reales.
# Nunca subas .env al repositorio.
# Las variables VITE_* se incrustan en el bundle en tiempo de build.
# ─────────────────────────────────────────────────────────────────────────────

# URL base de la API del backend.
# En desarrollo apunta al servidor Express local.
# En producción apunta al dominio real (sin barra final).
# Si está vacío, las peticiones se hacen relativas al origen (/ — válido detrás de nginx).
VITE_API_URL=http://localhost:3000

# URL canónica pública del sitio.
# Usada en markdownComponents.jsx para construir URLs absolutas de compartir.
# Ejemplo: https://guadalupecano.es
VITE_SITE_URL=https://guadalupecano.es
