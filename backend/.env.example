# ─────────────────────────────────────────────────────────────────────────────
# Backend — variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# Nunca subas .env al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Puerto de escucha del servidor Express (por defecto 3000)
PORT=3000

# URL pública del frontend. Afecta a CORS y al sitemap generado.
# Ejemplo: https://guadalupecano.es
FRONTEND_URL=

# URL canónica del sitio (usada en OG meta tags de /api/og).
# Si no se define, se usa FRONTEND_URL como fallback.
# Ejemplo: https://guadalupecano.es
SITE_URL=

# ── CMS /bitacora — credenciales de acceso ───────────────────────────────────
# OBLIGATORIO — el servidor no arranca sin estas tres variables.
CMS_USERNAME=
CMS_PASSWORD=
JWT_SECRET=

# ── Email / Contacto ─────────────────────────────────────────────────────────
# Necesarios para que /api/contact envíe correos.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Habilita el endpoint /api/chat. Sin esta clave el chat devuelve 503.
GEMINI_API_KEY=

# ── Contenido (posts, projects, imágenes) ────────────────────────────────────
# Ruta física donde el backend lee y escribe posts/projects/imágenes.
# Si no se define, usa ../frontend/public como raíz legacy/local.
# En Docker se monta el volumen compartido en /data/content.
CONTENT_PATH=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# DATABASE_URL tiene prioridad sobre las variables individuales.
# Formato: postgres://user:password@host:port/database
DATABASE_URL=
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=disable

# ── (Legado, ignorar si usas DATABASE_URL) ───────────────────────────────────
# VITE_API_URL — solo es de frontend, no aplica aquí.
